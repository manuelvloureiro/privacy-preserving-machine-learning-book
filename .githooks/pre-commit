#!/bin/sh
# Format staged files the way VSCode does on save, then re-stage them.
#
#   Python:          ruff format, ruff's safe fixes and import sorting (settings in pyproject.toml).
#   Markdown, .qmd:  trim trailing whitespace and end with a newline.
#
# Markdown is not run through Prettier: its escaping rewrites LaTeX inside $...$ (\| becomes |, \{ becomes {,
# w_{t+1} becomes w\_{t+1}) and its wrapping can turn a line into a list item. Lint problems ruff can't fix
# don't block the commit, just as they don't block a save.
#
# A file with unstaged changes stops the commit, since formatting and re-staging it would stage those too.

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py' '*.md' '*.qmd')
[ -z "$files" ] && exit 0

partial=$(printf '%s\n' "$files" | while IFS= read -r f; do git diff --quiet -- "$f" || echo "$f"; done)
if [ -n "$partial" ]; then
    echo "pre-commit: these files have unstaged changes. Stage or stash them, then commit again:" >&2
    printf '  %s\n' $partial >&2
    exit 1
fi

py=$(printf '%s\n' "$files" | grep '\.py$')
if [ -n "$py" ]; then
    printf '%s\n' "$py" | tr '\n' '\0' | xargs -0 uv run --quiet ruff check --fix --exit-zero --quiet || exit 1
    printf '%s\n' "$py" | tr '\n' '\0' | xargs -0 uv run --quiet ruff format --quiet || exit 1
fi

printf '%s\n' "$files" | grep -E '\.(md|qmd)$' | while IFS= read -r f; do
    sed -i 's/[[:space:]]*$//' "$f"
    [ -n "$(tail -c 1 "$f")" ] && echo >> "$f"
done

printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 git add --
