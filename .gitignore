# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local settings of Claude Code and editors
.claude/settings.local.json
.vscode/

# Datasets are kept locally, not committed. adult_with_pii.csv (UCI Adult with fabricated names,
# birth dates and SSNs) is not used by any chapter yet.
data/

# Earlier code, kept locally for reference only
archive/

# Quarto build output: `make` renders from staged copies in _build/ into _book/
_book/
_build/
book-*/.quarto/
# Generated by tools/terms.py into the staged copies, never into the books' folders
book-*/glossary.md
book-*/term-index.md
book-*/_terms.json

# Figures are generated by the scripts in code/ (`make figures`, run by every build) into
# _build/figures/, and copied into each staged book; they are never committed
book-*/*/figures/

# Study notes are rendered from staged copies too
notes/*/.quarto/
notes/*/_site/
