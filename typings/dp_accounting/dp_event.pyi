class DpEvent: ...
class NoOpDpEvent(DpEvent): ...
class NonPrivateDpEvent(DpEvent): ...

class GaussianDpEvent(DpEvent):
    noise_multiplier: float
    def __init__(self, noise_multiplier: float) -> None: ...

class LaplaceDpEvent(DpEvent):
    noise_multiplier: float
    def __init__(self, noise_multiplier: float) -> None: ...

class DiscreteLaplaceDpEvent(DpEvent):
    def __init__(self, noise_parameter: float, sensitivity: int) -> None: ...

class ZCDpEvent(DpEvent):
    def __init__(self, rho: float, xi: float = 0.0) -> None: ...

class RandomizedResponseDpEvent(DpEvent):
    def __init__(self, noise_parameter: float, num_buckets: int) -> None: ...

class PoissonSampledDpEvent(DpEvent):
    sampling_probability: float
    event: DpEvent
    def __init__(self, sampling_probability: float, event: DpEvent) -> None: ...

class SampledWithoutReplacementDpEvent(DpEvent):
    def __init__(self, source_dataset_size: int, sample_size: int, event: DpEvent) -> None: ...

class SampledWithReplacementDpEvent(DpEvent):
    def __init__(self, source_dataset_size: int, sample_size: int, event: DpEvent) -> None: ...

class SelfComposedDpEvent(DpEvent):
    event: DpEvent
    count: int
    def __init__(self, event: DpEvent, count: int) -> None: ...

class ComposedDpEvent(DpEvent):
    events: list[DpEvent]
    def __init__(self, events: list[DpEvent]) -> None: ...

class RepeatAndSelectDpEvent(DpEvent):
    def __init__(self, event: DpEvent, mean: float, shape: float) -> None: ...
