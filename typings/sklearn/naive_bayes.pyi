from typing import Self

import numpy as np
from numpy.typing import ArrayLike, NDArray

from sklearn.base import BaseEstimator, ClassifierMixin

class GaussianNB(ClassifierMixin, BaseEstimator):
    def __init__(self, *, priors: ArrayLike | None = None, var_smoothing: float = 1e-09) -> None: ...
    def fit(self, X: ArrayLike, y: ArrayLike, sample_weight: ArrayLike | None = None) -> Self: ...
    def predict(self, X: ArrayLike) -> NDArray[np.int64]: ...
    def predict_proba(self, X: ArrayLike) -> NDArray[np.float64]: ...
