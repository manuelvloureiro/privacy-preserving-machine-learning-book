# The core classes of OpenDP 0.16.0 (opendp/mod.py), typed by hand for strict pyright. The package ships inline
# types, but its star-import prelude and its untyped `map`, `__call__` and `invoke` methods do not pass strict mode,
# so the parts the scripts use are declared here with the real signatures. See typings/README.md.
from collections.abc import Callable, Sequence
from typing import Any, Generic, Type, TypeVar, overload

from opendp.typing import RuntimeType

T = TypeVar("T", Transformation, Measurement, Odometer)
M = TypeVar("M", Transformation, Measurement)
D = TypeVar("D")

class Function:
    def __call__(self, arg: Any) -> Any: ...

class Queryable:
    def __init__(self, value: Any, query_type: Any) -> None: ...
    def __call__(self, query: Any) -> Any: ...

class OdometerQueryable:
    def __call__(self, query: Any) -> Any: ...
    def invoke(self, query: Any) -> Any: ...
    def privacy_loss(self, d_in: Any) -> Any: ...

class Domain:
    def member(self, val: Any) -> bool: ...
    @property
    def type(self) -> RuntimeType | str: ...
    @property
    def carrier_type(self) -> RuntimeType | str: ...
    def cast(self, type_: Type[D]) -> D: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class AtomDomain(Domain):
    @property
    def bounds(self) -> tuple[float, float]: ...
    @property
    def nan(self) -> bool: ...

class OptionDomain(Domain):
    @property
    def element_domain(self) -> Domain: ...

class VectorDomain(Domain):
    @property
    def element_domain(self) -> Domain: ...
    @property
    def size(self) -> int | None: ...

class SeriesDomain(Domain):
    @property
    def name(self) -> str: ...
    @property
    def element_domain(self) -> Domain: ...
    @property
    def nullable(self) -> bool: ...

class LazyFrameDomain(Domain):
    @property
    def columns(self) -> list[str]: ...
    def get_series_domain(self, name: str) -> SeriesDomain: ...
    def get_margin(self, by: Sequence[Any]) -> Any: ...

class ExtrinsicDomain(Domain):
    @property
    def descriptor(self) -> Any: ...

class Metric:
    @property
    def type(self) -> RuntimeType | str: ...
    @property
    def distance_type(self) -> RuntimeType | str: ...
    def cast(self, type_: Type[D]) -> D: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ExtrinsicDistance(Metric):
    @property
    def descriptor(self) -> Any: ...

class FrameDistance(Metric):
    @property
    def inner_metric(self) -> Metric: ...

class SymmetricIdDistance(Metric):
    @property
    def identifier(self) -> Any: ...

class ChangeOneIdDistance(Metric):
    @property
    def identifier(self) -> Any: ...

class Measure:
    @property
    def type(self) -> RuntimeType | str: ...
    @property
    def distance_type(self) -> RuntimeType | str: ...
    def cast(self, type_: Type[D]) -> D: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class ExtrinsicDivergence(Measure):
    @property
    def descriptor(self) -> Any: ...

class ApproximateDivergence(Measure):
    @property
    def inner_measure(self) -> Measure: ...

class PrivacyProfile:
    """The privacy curve of a smoothed-max-divergence release: δ as a function of ε, and the other way round."""

    def delta(self, epsilon: float) -> float: ...
    def epsilon(self, delta: float) -> float: ...

class PartialConstructor(Generic[T]):
    """What a `then_*` constructor returns: a constructor waiting for its input domain and metric, which it takes
    from `(domain, metric) >> then_x(...)` or from the transformation before it in a chain."""

    def __call__(self, input_domain: Domain, input_metric: Metric) -> T: ...
    def __rshift__(self, other: Any) -> PartialConstructor[Any]: ...
    def __rrshift__(self, other: tuple[Domain, Metric]) -> T: ...

_PartialConstructor = PartialConstructor

class Measurement:
    def __call__(self, arg: Any) -> Any: ...
    def invoke(self, arg: Any) -> Any: ...
    def map(self, d_in: Any) -> Any: ...
    def check(self, d_in: Any, d_out: Any, *, debug: bool = False) -> bool: ...
    def __rshift__(self, other: Function | Transformation | Callable[..., Any]) -> Measurement: ...
    @property
    def input_domain(self) -> Domain: ...
    @property
    def input_metric(self) -> Metric: ...
    @property
    def input_space(self) -> tuple[Domain, Metric]: ...
    @property
    def output_measure(self) -> Measure: ...
    @property
    def function(self) -> Function: ...
    @property
    def input_distance_type(self) -> RuntimeType | str: ...
    @property
    def output_distance_type(self) -> RuntimeType | str: ...
    @property
    def input_carrier_type(self) -> RuntimeType | str: ...

class Odometer:
    def __call__(self, arg: Any) -> OdometerQueryable: ...
    def invoke(self, arg: Any) -> OdometerQueryable: ...
    @property
    def input_domain(self) -> Domain: ...
    @property
    def input_metric(self) -> Metric: ...
    @property
    def input_space(self) -> tuple[Domain, Metric]: ...
    @property
    def output_measure(self) -> Measure: ...
    @property
    def input_distance_type(self) -> RuntimeType | str: ...
    @property
    def output_distance_type(self) -> RuntimeType | str: ...
    @property
    def input_carrier_type(self) -> RuntimeType | str: ...

class Transformation:
    def __call__(self, arg: Any) -> Any: ...
    def invoke(self, arg: Any) -> Any: ...
    def map(self, d_in: Any) -> Any: ...
    def check(self, d_in: Any, d_out: Any, *, debug: bool = False) -> bool: ...
    @overload
    def __rshift__(self, other: Transformation) -> Transformation: ...
    @overload
    def __rshift__(self, other: Measurement) -> Measurement: ...
    @overload
    def __rshift__(self, other: Odometer) -> Odometer: ...
    @overload
    def __rshift__(self, other: PartialConstructor[T]) -> T: ...
    @overload
    def __rshift__(self, other: Any) -> Any: ...
    @property
    def input_domain(self) -> Domain: ...
    @property
    def output_domain(self) -> Domain: ...
    @property
    def input_metric(self) -> Metric: ...
    @property
    def output_metric(self) -> Metric: ...
    @property
    def input_space(self) -> tuple[Domain, Metric]: ...
    @property
    def output_space(self) -> tuple[Domain, Metric]: ...
    @property
    def function(self) -> Function: ...
    @property
    def input_distance_type(self) -> RuntimeType | str: ...
    @property
    def output_distance_type(self) -> RuntimeType | str: ...
    @property
    def input_carrier_type(self) -> RuntimeType | str: ...

class UnknownTypeException(Exception): ...

class OpenDPException(Exception):
    variant: str
    message: str | None
    raw_traceback: str | None
    def __init__(self, variant: str, message: str | None = None, raw_traceback: str | None = None) -> None: ...

def enable_features(*features: str) -> None: ...
def disable_features(*features: str) -> None: ...
def assert_features(*features: str) -> None: ...
def binary_search_chain(
    make_chain: Callable[[float], M],
    d_in: Any,
    d_out: Any,
    bounds: tuple[float | None, float | None] | None = (None, None),
    T: Type[float] | Type[int] | None = None,
) -> M: ...
def binary_search_param(
    make_chain: Callable[[float], Transformation | Measurement],
    d_in: Any,
    d_out: Any,
    bounds: tuple[float | None, float | None] | None = (None, None),
    T: Type[float] | Type[int] | None = None,
) -> float: ...
def binary_search(
    predicate: Callable[[float], bool],
    bounds: tuple[float | None, float | None] | None = (None, None),
    T: Type[float] | Type[int] | None = None,
    return_sign: bool = False,
) -> float: ...
def exponential_bounds_search(
    predicate: Callable[[float], bool], T: Type[float] | Type[int] | None
) -> tuple[float, float] | None: ...
def serialize(dp_obj: Any) -> str: ...
def deserialize(dp_json: str) -> Any: ...
def get_opendp_version() -> str: ...
